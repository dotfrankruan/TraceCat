# TraceCat Controller secrets — install as /etc/tracecat/controller.env
#   install -m 0600 -o root -g tracecat deploy/systemd/tracecat-controller.env.example /etc/tracecat/controller.env
#
# Choose ONE authentication mode in controller.json.

# local auth mode: PBKDF2-HMAC-SHA256 password hash generated with:
#   tracecat-controller -hash-password
TRACECAT_CONTROLLER_PASSWORD_HASH=pbkdf2-sha256$210000$REPLACE$REPLACE

# cloudflare auth mode: no Cloudflare API token or shared secret is required at
# the origin. Access is verified cryptographically against the team JWKS.
# If controller.json sets auth.cloudflare.csrf_secret_env (recommended for
# multi-replica deployments), provide that variable here:
TRACECAT_CSRF_SECRET=REPLACE_WITH_32_BYTES_OF_RANDOM_BASE64

# Optional: override non-secret settings (systemd EnvironmentFile syntax).
# TRACECAT_LOG_LEVEL=info
