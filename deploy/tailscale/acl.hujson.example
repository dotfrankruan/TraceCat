// TraceCat tailnet policy example (Tailscale ACL / HuJSON).
//
// Goals:
//   - Only the Controller can reach Agents, and only on the Agent HTTPS/HTTP
//     service port. Users never reach Agents directly; they use the Controller
//     dashboard through Cloudflare Access (or a private tailnet address).
//   - Agents cannot initiate connections to each other or to the Controller.
//
// Apply this in the Tailscale admin console (Access Controls). Tag your nodes:
//   tailscale up --advertise-tags=tag:tracecat-controller
//   tailscale up --advertise-tags=tag:tracecat-agent
// Then replace the placeholder ports/names with your deployment values.
// Tailscale ACLs are network authorization only: TraceCat additionally
// requires a per-Agent bearer token, so tailnet membership alone is not
// sufficient to run traces.
{
  "tagOwners": {
    "tag:tracecat-controller": ["autogroup:admin"],
    "tag:tracecat-agent": ["autogroup:admin"]
  },
  "acls": [
    // Controller -> Agent API only (agent listen port, e.g. 8443).
    {
      "action": "accept",
      "src": ["tag:tracecat-controller"],
      "dst": ["tag:tracecat-agent:8443"]
    },
    // Operators -> Controller, only if you expose it over the tailnet instead
    // of (or in addition to) Cloudflare Tunnel. Comment out if not needed.
    {
      "action": "accept",
      "src": ["autogroup:admin"],
      "dst": ["tag:tracecat-controller:8080"]
    }
  ],
  "ssh": []
}
