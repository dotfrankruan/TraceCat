# TraceCat Agent secret — install as /etc/tracecat/agent.env
#   install -m 0600 -o root -g root deploy/systemd/tracecat-agent.env.example /etc/tracecat/agent.env
#
# A separate high-entropy credential per Agent. Generate one with:
#   openssl rand -base64 48
# The same value must be configured on the Controller in the Agent's
# token_env-named environment variable. Never commit real values.
TRACECAT_AGENT_TOKEN=REPLACE_WITH_48_BYTES_OF_RANDOM_BASE64
